  "discovered_root_causes": [
    {
      "id": "RC-CL-1",
      "component": "Head-Sampling Truncation (Ctu13Adapter)",
      "finding": "Phase 11B loaded rows 0 to 30,000 sequentially from the file head. In CTU-13, botnets undergo hours of benign/background setup before active execution. Scenario 10 first attack flow is at index 90,622; top flood storm is at 460,000-530,000. Consequently, the evaluated slice of Scenario 10 had support_attack = 0 (100% benign), mathematically forcing Precision=0, Recall=0, F1=0, and ROC-AUC=NaN.",
      "severity": "CRITICAL",
      "remediation": "Enhanced Ctu13Adapter with optional skip_rows parameter to target active attack waves."
    },
    {
      "id": "RC-CL-2",
      "component": "Heavy-Tailed Variance Dominance & Zero-IQR Fallback",
      "finding": "In the 280-D state vector, 163 features had IQR = 0.0 on training states. RobustScaler fell back to scale = 1.0 while microsecond duration and byte counters reached up to 3.6e9. These unscaled features dominated gradients by 10^18, pushing weights of critical binary/ratio signals (TCP flags, SYN ratios) toward zero.",
      "severity": "CRITICAL",
      "remediation": "Implemented log1p non-negative counter stabilization prior to scaling."
    },
    {
      "id": "RC-CL-3",
      "component": "Uncalibrated Threshold on Skewed Class Distribution",
      "finding": "Phase 11B evaluated Logistic Regression at a hardcoded decision threshold of 0.5. With extreme class imbalance and massive feature scaling distortions, the model generated 2,398 false positives against 14 true positives on Known Test.",
      "severity": "HIGH",
      "remediation": "Threshold calibration strictly optimized on Validation scenarios (11 & 12)."
    },
    {
      "id": "RC-CL-4",
      "component": "Validation Set Attack Starvation",
      "finding": "In Phase 11B, Validation Scenarios 11 & 12 had first botnet flows at 54,001 and 55,370. Head-sampling 30,000 rows produced 0 attack flows in Validation, making validation calibration impossible.",
      "severity": "HIGH",
      "remediation": "Validation sampled at active attack offsets, providing positive labels for tuning."
    }
  ],
